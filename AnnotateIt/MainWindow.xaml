<Window x:Class="AnnotateIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate It Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Left="0" Top="0">

    <!-- Primary fullscreen ink capture surface -->
    <InkCanvas x:Name="OverlayCanvas"
               Background="#01000000" />
</Window>
