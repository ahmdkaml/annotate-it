<!-- ======================================================================= -->
<!-- Application Root Window: Transparent full-screen overlay for annotations -->
<!-- ======================================================================= -->
<Window x:Class="AnnotateIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate It Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Left="0"
        Top="0"
        MouseDown="Overlay_MouseDown">

    <!-- =================================================================== -->
    <!-- Root Layout: Houses both the dynamic canvas and static HUD elements -->
    <!-- =================================================================== -->
    <Grid>
        <!-- =============================================================== -->
        <!-- Overlay Canvas: Captures pointer events and hosts visual items. -->
        <!-- #01000000 provides the minimum alpha required for hit-testing.  -->
        <!-- =============================================================== -->
        <Canvas x:Name="OverlayCanvas"
                Background="#01000000" />

        <!-- =============================================================== -->
        <!-- Development Diagnostics HUD: Displays intercepted click data.   -->
        <!-- IsHitTestVisible="False" prevents it from absorbing mouse input.-->
        <!-- =============================================================== -->
        <Border x:Name="DebugHudContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#99000000"
                CornerRadius="6"
                Padding="16,8"
                IsHitTestVisible="False">
            <TextBlock x:Name="DebugText"
                       Foreground="#FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="Initializing overlay..."/>
        </Border>
    </Grid>
</Window>
