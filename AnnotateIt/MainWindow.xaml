<!-- ======================================================================= -->
<!-- Application Root Window: Transparent full-screen overlay for annotations -->
<!-- ======================================================================= -->
<Window x:Class="AnnotateIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate It Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Left="0"
        Top="0"
        MouseDown="Overlay_MouseDown">

    <!-- =================================================================== -->
    <!-- Root Layout: Houses the interactive drawing and UI canvas           -->
    <!-- =================================================================== -->
    <Grid>
        <!-- =============================================================== -->
        <!-- Overlay Canvas: Hit-test surface and container for panel/drawings-->
        <!-- =============================================================== -->
        <Canvas x:Name="OverlayCanvas"
                Background="#01000000">

            <!-- =========================================================== -->
            <!-- Floating Control Panel: Draggable HUD for tool interactions -->
            <!-- =========================================================== -->
            <Border x:Name="ControlPanelContainer"
                    Canvas.Left="40"
                    Canvas.Top="40"
                    Width="300"
                    Background="#1E1E2E"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.45"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Drag Handle Header -->
                        <RowDefinition Height="36"/>
                        <!-- Tool Actions Container -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header / Drag Bar -->
                    <Border Grid.Row="0"
                            Background="#181825"
                            CornerRadius="7,7,0,0"
                            Cursor="SizeAll"
                            Padding="12,0"
                            MouseDown="PanelHeader_MouseDown"
                            MouseMove="PanelHeader_MouseMove"
                            MouseUp="PanelHeader_MouseUp">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮"
                                           Foreground="#A6ADC8"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Annotate It"
                                           Foreground="#CDD6F4"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="20"
                                    Height="20"
                                    Content="✕"
                                    FontSize="10"
                                    Foreground="#BAC2DE"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="CloseButton_Click"
                                    ToolTip="Exit Application"/>
                        </Grid>
                    </Border>

                    <!-- Tool Area Placeholder -->
                    <StackPanel Grid.Row="1" Margin="12" Orientation="Vertical">
                        <TextBlock Text="Tools"
                                   Foreground="#A6ADC8"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PenToolButton"
                                    Content="Pen"
                                    Width="60"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Background="#89B4FA"
                                    Foreground="#11111B"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="PenButton_Click"/>
                            <Button x:Name="EraserToolButton"
                                    Content="Eraser"
                                    Width="60"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Background="#313244"
                                    Foreground="#CDD6F4"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="EraserButton_Click"/>
                            <Button x:Name="PassThroughButton"
                                    Content="Pass"
                                    Width="60"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Background="#313244"
                                    Foreground="#CDD6F4"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="PassThroughButton_Click"
                                    ToolTip="Pass clicks to desktop"/>
                            <Button x:Name="ClearButton"
                                    Content="Clear"
                                    Width="60"
                                    Height="30"
                                    Background="#313244"
                                    Foreground="#CDD6F4"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Canvas>
    </Grid>
</Window>
